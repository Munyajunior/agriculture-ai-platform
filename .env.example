# Database
DB_PASSWORD=your_secure_password_here_change_in_production
DATABASE_URL=postgresql://agri_user:${DB_PASSWORD}@postgres:5432/agriculture_ai

# Redis
REDIS_PASSWORD=your_redis_password_here
REDIS_URL=redis://:${REDIS_PASSWORD}@redis:6379/0

# Security
SECRET_KEY=your_super_secret_jwt_key_change_this
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# MinIO/Object Storage
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin123
MINIO_BUCKET=agriculture-images

# Service URLs
AUTH_SERVICE_URL=http://auth-service:8001
AI_SERVICE_URL=http://ai-service:8002
ANALYTICS_SERVICE_URL=http://analytics-service:8003
MEDIA_SERVICE_URL=http://media-service:8004
MODEL_REGISTRY_URL=http://model-registry:8005
SYNC_SERVICE_URL=http://sync-service:8006

# AI Model Settings
MODEL_PATH=/models/mobilenetv3_best.pth
USE_GPU=false
MODEL_VERSION=1.0.0

# Application Settings
DEBUG=false
ENVIRONMENT=production
LOG_LEVEL=INFO

# CORS
CORS_ORIGINS=http://localhost:3000,http://localhost:8080,https://yourdomain.com

# Rate Limiting
RATE_LIMIT_REQUESTS=100
RATE_LIMIT_PERIOD=60

# Monitoring
ENABLE_METRICS=true
PROMETHEUS_MULTIPROC_DIR=/tmp

# Grafana
GRAFANA_PASSWORD=admin

# Email (for notifications)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASSWORD=your_app_password