FROM python:3.13-slim

WORKDIR /app

RUN apt-get update && apt-get install -y \
    curl \
    libgl1 \
    libglib2.0-0 \
    libsm6 \
    libxext6 \
    libxrender1 \
    libgomp1 \
    && rm -rf /var/lib/apt/lists/*
RUN pip install uv

COPY services/media-service /app/services/media-service

RUN uv pip install --system /app/services/media-service

WORKDIR /app/services/media-service

RUN mkdir -p /app/storage/originals /app/storage/thumbnails /app/storage/processed \
    && useradd -m -u 1000 appuser \
    && chown -R appuser:appuser /app
USER appuser

EXPOSE 8004

CMD ["python", "main.py"]
