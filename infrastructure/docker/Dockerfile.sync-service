FROM python:3.13-slim

WORKDIR /app

RUN apt-get update && apt-get install -y curl && rm -rf /var/lib/apt/lists/*
RUN pip install uv

COPY shared/types /app/shared/types
COPY services/sync-service /app/services/sync-service

RUN uv pip install --system /app/shared/types /app/services/sync-service

WORKDIR /app/services/sync-service

RUN useradd -m -u 1000 appuser && chown -R appuser:appuser /app
USER appuser

EXPOSE 8006

CMD ["python", "main.py"]
