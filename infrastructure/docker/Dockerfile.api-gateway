# infrastructure/docker/Dockerfile.api-gateway
FROM python:3.11-slim AS builder

WORKDIR /app

# Install uv
RUN pip install uv

# Copy dependency files
COPY services/api-gateway/pyproject.toml services/api-gateway/
COPY shared/types/pyproject.toml shared/types/

# Install dependencies
RUN cd services/api-gateway && uv pip install --system -e .

# Final stage
FROM python:3.11-slim

WORKDIR /app

# Install runtime dependencies
RUN apt-get update && apt-get install -y \
    curl \
    && rm -rf /var/lib/apt/lists/*

# Copy installed packages
COPY --from=builder /usr/local/lib/python3.11/site-packages /usr/local/lib/python3.11/site-packages
COPY --from=builder /usr/local/bin /usr/local/bin

# Copy application code
COPY services/api-gateway /app/services/api-gateway
COPY shared /app/shared

WORKDIR /app/services/api-gateway

# Create non-root user
RUN useradd -m -u 1000 appuser && chown -R appuser:appuser /app
USER appuser

EXPOSE 8000

CMD ["python", "main.py"]