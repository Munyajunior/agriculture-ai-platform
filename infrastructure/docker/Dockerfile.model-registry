FROM python:3.13-slim

WORKDIR /app

RUN apt-get update && apt-get install -y curl libgomp1 && rm -rf /var/lib/apt/lists/*
RUN pip install uv

COPY shared/types /app/shared/types
COPY services/model-registry /app/services/model-registry

RUN uv pip install --system /app/shared/types /app/services/model-registry

WORKDIR /app/services/model-registry

RUN mkdir -p /models/cache && useradd -m -u 1000 appuser && chown -R appuser:appuser /app /models
USER appuser

EXPOSE 8005

CMD ["python", "main.py"]
