# infrastructure/docker/Dockerfile.model-registry
FROM python:3.11-slim AS builder

WORKDIR /app

RUN apt-get update && apt-get install -y \
    gcc \
    g++ \
    && rm -rf /var/lib/apt/lists/*

RUN pip install uv

COPY services/model-registry/pyproject.toml services/model-registry/
COPY shared/types/pyproject.toml shared/types/

RUN cd services/model-registry && uv pip install --system -e .

FROM python:3.11-slim

WORKDIR /app

RUN apt-get update && apt-get install -y \
    curl \
    libgomp1 \
    && rm -rf /var/lib/apt/lists/*

COPY --from=builder /usr/local/lib/python3.11/site-packages /usr/local/lib/python3.11/site-packages
COPY --from=builder /usr/local/bin /usr/local/bin

COPY services/model-registry /app/services/model-registry
COPY shared /app/shared

WORKDIR /app/services/model-registry

RUN mkdir -p /app/models/cache

RUN useradd -m -u 1000 appuser && chown -R appuser:appuser /app
USER appuser

EXPOSE 8005

CMD ["python", "main.py"]