FROM python:3.13-slim

WORKDIR /app

RUN apt-get update && apt-get install -y \
    curl \
    libgl1 \
    libglib2.0-0 \
    libsm6 \
    libxext6 \
    libxrender1 \
    libgomp1 \
    && rm -rf /var/lib/apt/lists/*
RUN pip install uv

COPY shared/types /app/shared/types
COPY shared/inference-sdk /app/shared/inference-sdk
COPY services/ai-service /app/services/ai-service

RUN uv pip install --system /app/shared/types /app/shared/inference-sdk /app/services/ai-service

WORKDIR /app/services/ai-service

RUN mkdir -p /models && useradd -m -u 1000 appuser && chown -R appuser:appuser /app /models
USER appuser

EXPOSE 8002

CMD ["python", "main.py"]
