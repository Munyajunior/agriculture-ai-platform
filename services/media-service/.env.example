# Media Service Configuration
STORAGE_TYPE=minio  # minio, s3, r2, local
STORAGE_ENDPOINT=minio:9000
STORAGE_ACCESS_KEY=minioadmin
STORAGE_SECRET_KEY=minioadmin123
STORAGE_BUCKET=agriculture-images
STORAGE_REGION=us-east-1
STORAGE_SECURE=false
STORAGE_PUBLIC_URL=http://localhost:9000

# R2 Configuration (if using Cloudflare R2)
R2_ACCOUNT_ID=your-account-id
R2_ACCESS_KEY_ID=your-access-key
R2_SECRET_ACCESS_KEY=your-secret-key
R2_BUCKET_NAME=agriculture-ai

# Image Processing
MAX_IMAGE_SIZE_MB=10
IMAGE_QUALITY=85
THUMBNAIL_SIZES=[[64,64],[256,256],[512,512]]

# URL Signing
URL_EXPIRY_SECONDS=3600
SIGNING_SECRET=your-signing-secret-change-this