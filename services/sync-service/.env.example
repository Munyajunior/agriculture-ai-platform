
# Sync Service Configuration
SYNC_BATCH_SIZE=100
SYNC_INTERVAL_SECONDS=30
SYNC_RETRY_MAX=5
SYNC_RETRY_DELAY_SECONDS=60
SYNC_CONFLICT_STRATEGY=last_write_wins
QUEUE_MAX_SIZE=10000
QUEUE_WORKER_COUNT=4
DEVICE_HEARTBEAT_INTERVAL=60
DEVICE_OFFLINE_TIMEOUT=300
SYNC_LOG_RETENTION_DAYS=30
CONFLICT_LOG_RETENTION_DAYS=90

# MLflow (optional)
MLFLOW_TRACKING_URI=http://mlflow:5000
MLFLOW_EXPERIMENT_NAME=plant-disease-detection

# Device Headers for Sync
# X-Device-ID and X-User-ID headers should be sent with sync requests