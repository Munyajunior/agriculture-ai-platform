# Model Registry Configuration
MODEL_STORAGE_TYPE=minio
MODEL_STORAGE_ENDPOINT=minio:9000
MODEL_STORAGE_ACCESS_KEY=minioadmin
MODEL_STORAGE_SECRET_KEY=minioadmin123
MODEL_STORAGE_BUCKET=ai-models
MODEL_CACHE_PATH=/app/models/cache
MAX_CACHED_MODELS=5


# Model Registry API Security
MODEL_REGISTRY_API_KEY=your-secure-api-key-here-change-in-production

# Model Registry Storage
MODEL_STORAGE_TYPE=minio
MODEL_STORAGE_BUCKET=ai-models
ENABLE_MODEL_MONITORING=true
MODEL_METRICS_RETENTION_DAYS=30


# MLflow (optional)
MLFLOW_TRACKING_URI=http://mlflow:5000
MLFLOW_EXPERIMENT_NAME=plant-disease-detection